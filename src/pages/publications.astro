---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { publishedPublications } from '../lib/content';
import { site } from '../config';
const publications = await publishedPublications();
const structuredData = !site.profileIsPlaceholder && import.meta.env.SITE_CONFIGURED && Astro.site && publications.length ? { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: publications.map((p, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': 'ScholarlyArticle', name: p.data.title, author: p.data.authors.map((name) => ({ '@type': 'Person', name })), datePublished: String(p.data.year), description: p.data.abstract, ...(p.data.url || p.data.doi ? { url: p.data.url || p.data.doi } : {}) } })) } : undefined;
---
<BaseLayout title="Publications" description="An archive for verified research, papers, packages, and other published work." structuredData={structuredData}><div class="container"><PageIntro eyebrow="Research & contributions" title="Work worth sharing." description="Published work in astrostatistics and biomedical research, from exoplanet signals to placental pathology." /><section class="content-section" aria-label="Publications"><p class="muted">Brief summaries accompany each citation. Follow the DOI or publication link for the original paper.</p>{publications.length ? publications.map(({ data }) => <article class="publication"><p class="eyebrow">{data.year} · {data.venue}</p><h2>{data.title}</h2><p class="authors">{data.authors.join(', ')}</p><p class="publication-summary">{data.abstract}</p><div class="publication-links">{data.doi && <a href={data.doi}>DOI ↗</a>}{data.pdf && <a href={data.pdf}>Read PDF ↗</a>}{data.code && <a href={data.code}>Code ↗</a>}{data.url && <a href={data.url}>Publication ↗</a>}</div></article>) : <div class="empty-state"><h2>The archive starts here.</h2><p>No verified publications have been added yet. Research, papers, and packages will appear here when supplied by the owner.</p><a href="/projects/">Explore the project collection →</a></div>}</section></div></BaseLayout>
