---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import PersonalPhoto from '../components/PersonalPhoto.astro';
import ResearchImage from '../components/ResearchImage.astro';
import { site } from '../config';
import { publishedPosts, publishedProjects, publishedPublications } from '../lib/content';
const projects = (await publishedProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await publishedPosts()).filter((post) => !post.data.sample).slice(0, 3);
const publications = (await publishedPublications()).slice(0, 3);
---
<BaseLayout title="Home" description={site.description}>
<div class="container">
  <section class="hero hero-rich" aria-labelledby="hero-title">
    <div><p class="eyebrow">Parker Holzer · Data science & AI</p><h1 id="hero-title">Building <br /><em>High-Integrity AI</em></h1><p class="lede">{site.tagline}</p><div class="button-row"><a class="button primary" href="/projects/">Explore projects</a><a class="button" href="/resume/">View resume</a></div><p class="hero-caption">{site.introduction}</p></div>
    <figure class="hero-portrait">
      <PersonalPhoto kind="portrait" sizes="(max-width: 700px) calc(100vw - 72px), (max-width: 1100px) 40vw, 450px" class="portrait-image" priority />
      <figcaption><span>{site.name}</span><span>{site.role}</span></figcaption>
    </figure>
  </section>
  <div class="expertise-strip" aria-label="Portfolio topics">{site.expertise.map((area) => <div>{area}</div>)}</div>
  <section class="section" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">Ideas into practice</p><h2 id="projects-title">Selected projects</h2></div><a class="text-link" href="/projects/">All projects</a></div><div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></section>
  {publications.length > 0 && <section class="section" aria-labelledby="research-title"><div class="section-heading"><div><p class="eyebrow">From the research</p><h2 id="research-title">Published work</h2></div><a class="text-link" href="/publications/">All publications</a></div><div class="blog-grid">{publications.map(({ data }) => <article class="blog-card research-card"><ResearchImage data={data} compact /><div class="research-card-body"><div class="card-kicker"><span>Research article</span><span>{data.year}</span></div><h3><a href={data.doi || data.url}>{data.title}</a></h3><p>{data.abstract}</p><p class="article-meta">{data.venue}</p></div></article>)}</div></section>}
  {posts.length > 0 && <section class="section" aria-labelledby="writing-title"><div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2 id="writing-title">Recent writing</h2></div><a class="text-link" href="/blog/">All articles</a></div><div class="blog-grid">{posts.map((post) => <BlogCard post={post} />)}</div></section>}
  <section class="section about-band" aria-labelledby="about-title"><div><p class="eyebrow">A little more human</p><h2 id="about-title">Beyond the work.</h2></div><div><p class="lede">{site.personal}</p><a class="text-link" href="/about/">More about me</a></div></section>
  <section class="contact-band"><div><h2>Good work starts with a conversation.</h2><p>For ideas, questions, and potential collaborations.</p></div><a class="button" href="/contact/">Get in touch</a></section>
</div>
</BaseLayout>
