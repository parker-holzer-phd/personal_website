---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { publishedProjects } from '../../lib/content';
const projects = await publishedProjects();
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---
<BaseLayout title="Projects" description="Explore software, data science, statistics, and making projects by topic."><div class="container"><PageIntro eyebrow="A collection of explorations" title="Ideas, made tangible." description="Research code, housing models, learning notebooks, and statistical software. Explore the questions, methods, and original visuals behind the work." /><section class="content-section" aria-label="Project collection">{projects.some((p) => p.data.sample) && <p class="placeholder-note">Entries labeled “Sample project” are still awaiting details. Completed entries describe work documented in my resume and linked research.</p>}<FilterBar kind="projects" options={tags} /><div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>{!projects.length && <p class="empty-state">Projects will appear here as they are added.</p>}</section></div></BaseLayout>
