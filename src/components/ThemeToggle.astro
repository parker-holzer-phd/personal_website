<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use dark color theme" aria-pressed="false">
  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const readPreference = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', `Use ${dark ? 'light' : 'dark'} color theme`);
  };
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch { /* Theme still works without storage. */ }
    sync();
  });
  media.addEventListener('change', (event) => {
    if (!['light', 'dark'].includes(readPreference() || '')) document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
    sync();
  });
  sync();
</script>
