---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
---
<article class="blog-card" data-filter-item data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()} data-category={post.data.category} data-tags={JSON.stringify(post.data.tags)}>
  <div class="card-kicker"><span>{post.data.category}</span><span>{readingTime(post.body)} min read</span></div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title} <span aria-hidden="true">↗</span></a></h3><p>{post.data.description}</p>
  <div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.sample && <span class="sample-label">Sample article</span>}</div>
</article>
