---
import { site } from '../config';
const year = new Intl.DateTimeFormat('en-US', { year: 'numeric', timeZone: 'America/Denver' }).format(new Date());
---
<footer class="site-footer"><div class="container footer-inner">
  <div><a class="footer-name" href="/">{site.name}<span class="gold">.</span></a><p>A portfolio, a notebook, a work in progress.</p><small>© {year} {site.name}</small></div>
  <nav aria-label="Footer navigation"><a href="/contact/">Get in touch</a>{site.socials.github && <a href={site.socials.github}>GitHub</a>}{site.socials.linkedin && <a href={site.socials.linkedin}>LinkedIn</a>}{site.socials.scholar && <a href={site.socials.scholar}>Google Scholar</a>}<a href="/rss.xml">RSS feed</a></nav>
</div></footer>
