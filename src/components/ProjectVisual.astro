---
interface Props { variant?: string; }
const { variant = 'model' } = Astro.props;
---
<div class:list={['project-visual', `visual-${variant}`]} aria-hidden="true">
  {variant === 'signal' ? <svg viewBox="0 0 540 280"><g fill="none" stroke="currentColor"><circle cx="270" cy="140" r="37"/><circle cx="270" cy="140" r="70" opacity=".55"/><circle cx="270" cy="140" r="106" opacity=".25"/><path d="M40 140h172m116 0h172M270 20v60m0 120v60" opacity=".4"/></g><rect x="246" y="119" width="48" height="42" rx="8" fill="currentColor"/><path d="m258 140 9 8 16-18" fill="none" stroke="#142D4E" stroke-width="3"/><circle cx="112" cy="140" r="5" fill="currentColor"/><circle cx="428" cy="140" r="5" fill="currentColor"/></svg> : variant === 'package' ? <svg viewBox="0 0 540 280"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m270 45 86 49v98l-86 48-86-48V94Zm-86 49 86 49 86-49m-86 49v97m-43-171 86 49v51"/><path d="M65 100h70m-85 25h85m270 55h70m-70 25h45" opacity=".5"/></g><text x="263" y="198" fill="currentColor" font-size="30" font-family="monospace">R</text></svg> : variant === 'object' ? <svg viewBox="0 0 540 280"><g fill="none" stroke="currentColor"><path d="m270 40 115 66-115 66-115-66Zm-115 66v70l115 66 115-66v-70M270 172v70"/><path d="m155 124 115 66 115-66m-230 18 115 66 115-66m-230 18 115 66 115-66" opacity=".35"/></g></svg> : <svg viewBox="0 0 540 280"><g fill="none" stroke="currentColor"><path d="M65 220H480M85 240V45" opacity=".4"/><path d="M95 210C160 205 140 115 205 140S280 190 315 100s90-50 150-60" stroke-width="2"/></g>{[[110,190],[145,170],[170,120],[210,150],[250,155],[290,140],[330,85],[370,70],[410,50],[450,60]].map(([cx,cy]) => <circle cx={cx} cy={cy} r="4" fill="currentColor"/>)}</svg>}
</div>
